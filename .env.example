# /.env.example
# Copier en .env.local et remplir. .env.local est ignoré par git — ne JAMAIS
# committer de vraies clés.

# --- Supabase ---
# URL du projet (Settings > API) — sûre côté client
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique "anon" — sûre côté client, accès limité par RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" — SERVEUR UNIQUEMENT (API routes / server actions).
# Bypass RLS : ne JAMAIS l'exposer côté client (pas de préfixe NEXT_PUBLIC_,
# aucun import depuis un composant client). En cas de doute sur une fuite
# potentielle, le signaler plutôt que trancher seul.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL canonique du site (redirections OAuth Supabase, liens absolus)
# ex: http://localhost:3000 en dev, https://app.example.com en prod
NEXT_PUBLIC_SITE_URL=
